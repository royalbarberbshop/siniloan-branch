# Copy to .env.local and fill in values from your Supabase project.
# These are public browser values; never put a service-role key in the frontend.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Payment gateway secrets belong ONLY in Supabase Edge Function secrets,
# not in this file or any VITE_* variable.
